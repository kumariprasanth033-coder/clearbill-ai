# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The base URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_PUBLIC_APP_URL: The public HTTPS domain used to generate machine-readable QR codes
# for mobile phone scanning. Replace with your actual configured public domain after deployment:
# Example: VITE_PUBLIC_APP_URL=https://YOUR-REAL-PUBLIC-DOMAIN
# (For local testing across LAN Wi-Fi, you can set http://192.168.X.X:3000)
VITE_PUBLIC_APP_URL=https://YOUR-REAL-PUBLIC-DOMAIN

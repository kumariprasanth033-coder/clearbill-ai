# =============================================================================
# CLEARBILL AI - BACKEND ENVIRONMENT CONFIGURATION (XAMPP & PRODUCTION)
# =============================================================================

# Server Port
PORT=3000
NODE_ENV=development

# MySQL Database Configuration (XAMPP Local Development)
# On Windows with XAMPP:
# 1. Start Apache & MySQL from XAMPP Control Panel
# 2. Database Name: clearbill_ai
# 3. Default XAMPP user is 'root' with empty password, but creating a dedicated
#    application user 'clearbill_app' is strongly recommended (see XAMPP_SETUP_GUIDE.md)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=clearbill_ai
DB_USER=clearbill_app
DB_PASSWORD=
DB_SSL=false
DB_CONNECTION_LIMIT=10

# Session & JWT Secrets
JWT_SECRET=clearbill_secret_jwt_key_development_2026

# Optional Gemini AI API for Store Analytics & Intelligent Receipt Explanations
# Set via AI Studio Secrets or environment variable:
GEMINI_API_KEY=

# Base Application URL for QR Receipt Link Generation
APP_URL=http://localhost:3000
